 "html": "<!-- \r\n  ERPNext / Frappe Print Format: Sales Invoice\r\n  Carpenters Waters (Fiji) Pte Limited\r\n  DocType: Sales Invoice\r\n-->\r\n\r\n<style>\r\n  @page {\r\n    size: A4 portrait;\r\n    margin: 14mm 12mm 14mm 12mm;\r\n  }\r\n\r\n  body, * {\r\n    box-sizing: border-box;\r\n    font-family: Arial, sans-serif;\r\n    font-size: 9pt;\r\n    color: #000;\r\n  }\r\n\r\n  .pf-wrapper {\r\n    width: 100%;\r\n    max-width: 780px;\r\n    margin: 0 auto;\r\n  }\r\n\r\n  /* \u2500\u2500 HEADER \u2500\u2500 */\r\n  .pf-header {\r\n    display: flex;\r\n    align-items: flex-start;\r\n    justify-content: space-between;\r\n    margin-bottom: 8px;\r\n  }\r\n  .pf-header .header-left-spacer {\r\n    flex: 0 0 100px;\r\n  }\r\n  .pf-header .header-center {\r\n    flex: 1;\r\n    text-align: center;\r\n  }\r\n  .pf-header .header-qr {\r\n    flex: 0 0 100px;\r\n    text-align: right;\r\n  }\r\n  .pf-header .company-name {\r\n    font-size: 13pt;\r\n    font-weight: bold;\r\n    letter-spacing: 0.5px;\r\n  }\r\n  .pf-header .company-sub {\r\n    font-size: 8pt;\r\n    line-height: 1.5;\r\n    margin-top: 2px;\r\n  }\r\n\r\n  /* Title row */\r\n  .title-row {\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    margin-top: 8px;\r\n    margin-bottom: 6px;\r\n    position: relative;\r\n  }\r\n  .title-row .doc-title {\r\n    font-size: 12pt;\r\n    font-weight: bold;\r\n    letter-spacing: 2px;\r\n    text-align: center;\r\n    flex: 1;\r\n  }\r\n\r\n  /* \u2500\u2500 HEADER FIELDS \u2500\u2500 */\r\n  .header-fields {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    margin-bottom: 4px;\r\n  }\r\n  .header-fields td {\r\n    border: none;\r\n    padding: 5px 5px;\r\n    vertical-align: middle;\r\n  }\r\n  .header-fields .field-label {\r\n    font-weight: bold;\r\n    white-space: nowrap;\r\n    padding-right: 6px;\r\n    width: 1%;\r\n  }\r\n  .header-fields .field-value {\r\n    min-width: 120px;\r\n  }\r\n  .header-fields .col-divider {\r\n    width: 30px;\r\n    border: none;\r\n  }\r\n\r\n  /* \u2500\u2500 TABLES \u2500\u2500 */\r\n  table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n  }\r\n  td, th {\r\n    border: 1px solid #555;\r\n    padding: 3px 5px;\r\n    vertical-align: middle;\r\n  }\r\n  th {\r\n    background-color: #d9d9d9;\r\n    font-weight: bold;\r\n    text-align: center;\r\n    font-size: 8.5pt;\r\n  }\r\n\r\n  .items-table th { text-align: center; }\r\n  .items-table td { text-align: center; }\r\n  .items-table td.desc-col { text-align: left; }\r\n  .items-table td.amount-col { text-align: right; padding-right: 6px; }\r\n  .items-table tr.empty-row td { height: 20px; }\r\n\r\n  /* Totals table */\r\n  .totals-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n  }\r\n  .totals-table td {\r\n    border: 1px solid #555;\r\n    padding: 5px 8px;\r\n  }\r\n  .totals-table td.lbl {\r\n    font-weight: bold;\r\n    background-color: #f0f0f0;\r\n    width: 50%;\r\n    white-space: nowrap;\r\n  }\r\n  .totals-table td.val {\r\n    text-align: right;\r\n    width: 50%;\r\n    font-size: 9.5pt;\r\n  }\r\n  .totals-table tr.total-row td {\r\n    font-weight: bold;\r\n    font-size: 10pt;\r\n  }\r\n\r\n  /* Signatures */\r\n  .sig-label {\r\n    font-weight: bold;\r\n    font-size: 8pt;\r\n  }\r\n\r\n  /* Conditions box */\r\n  .conditions-box {\r\n    border: 1px solid #555;\r\n    padding: 4px 8px;\r\n    font-size: 7.5pt;\r\n    margin-top: 6px;\r\n  }\r\n  .conditions-box ul {\r\n    margin: 2px 0 0 0;\r\n    padding-left: 14px;\r\n  }\r\n  .conditions-box ul li { margin-bottom: 1px; }\r\n\r\n  /* Footer */\r\n  .pf-footer {\r\n    margin-top: 6px;\r\n    display: flex;\r\n    justify-content: space-between;\r\n    font-size: 8pt;\r\n    border-top: 1px solid #555;\r\n    padding-top: 3px;\r\n  }\r\n\r\n  .goods-received {\r\n    font-size: 8pt;\r\n    font-weight: bold;\r\n    margin-top: 10px;\r\n  }\r\n</style>\r\n\r\n<div class=\"pf-wrapper\">\r\n\r\n  <!-- \u2550\u2550 COMPANY HEADER \u2014 center text, QR top-right \u2550\u2550 -->\r\n  <div class=\"pf-header\">\r\n\r\n    <!-- Left spacer to keep company name centered -->\r\n    <div class=\"header-left-spacer\"></div>\r\n\r\n    <!-- Center: company name + address -->\r\n    <div class=\"header-center\">\r\n      <div class=\"company-name\">CARPENTERS WATERS (FIJI) PTE LIMITED</div>\r\n      <div class=\"company-sub\">\r\n        Registered Office: 34 Rodwell Road, Suva. Phone: (679) 331 3122<br>\r\n        Branch: Vuqele, P.O. Box 878, Tavua, Fiji &nbsp;|&nbsp; Phone: (679) 999 1070 &nbsp;|&nbsp; TIN: 50-51708-0-6\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Right: QR Code generated via frappe.call -->\r\n    <div class=\"header-qr\">\r\n      {% set qr_data = frappe.call(\r\n          \"erpnext.accounts.doctype.sales_invoice.qr_utils.get_invoice_qr_code\",\r\n          invoice_name=doc.name\r\n      ) %}\r\n      {% if qr_data %}\r\n        <img src=\"{{ qr_data }}\"\r\n             style=\"width:100px; height:100px;\"\r\n             alt=\"QR Code\">\r\n      {% endif %}\r\n    </div>\r\n\r\n  </div>\r\n\r\n  <!-- \u2550\u2550 SALES INVOICE title centred \u2550\u2550 -->\r\n  <div class=\"title-row\">\r\n    <span class=\"doc-title\">SALES INVOICE</span>\r\n  </div>\r\n\r\n  <!-- \u2550\u2550 TO / ADDRESS / DATE (left) + INVOICE NO / CUSTOMER AC / LPO (right) \u2550\u2550 -->\r\n  <table class=\"header-fields\">\r\n    <tr>\r\n      <td class=\"field-label\">TO:</td>\r\n      <td class=\"field-value\" style=\"width:38%;\">{{ doc.customer_name or doc.customer }}</td>\r\n      <td class=\"col-divider\"></td>\r\n      <td class=\"field-label\">SALES INVOICE NO.:</td>\r\n      <td class=\"field-value\" style=\"width:22%;\">{{ doc.name }}</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"field-label\">ADDRESS:</td>\r\n      <td class=\"field-value\">\r\n        {% if doc.customer_address %}\r\n          {{ frappe.get_doc(\"Address\", doc.customer_address).address_line1 or \"\" }}\r\n          {% if frappe.get_doc(\"Address\", doc.customer_address).city %}, {{ frappe.get_doc(\"Address\", doc.customer_address).city }}{% endif %}\r\n        {% else %}&nbsp;{% endif %}\r\n      </td>\r\n      <td class=\"col-divider\"></td>\r\n      <td class=\"field-label\">CUSTOMER A/C NO.:</td>\r\n      <td class=\"field-value\">{{ doc.debit_to or \"&nbsp;\" }}</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"field-label\">DATE:</td>\r\n      <td class=\"field-value\">{{ frappe.utils.formatdate(doc.posting_date, \"dd/MM/yyyy\") }}</td>\r\n      <td class=\"col-divider\"></td>\r\n      <td class=\"field-label\">LPO NO.:</td>\r\n      <td class=\"field-value\">{{ doc.po_no or \"&nbsp;\" }}</td>\r\n    </tr>\r\n  </table>\r\n\r\n  <!-- \u2550\u2550 LINE ITEMS \u2550\u2550 -->\r\n  <table class=\"items-table\" style=\"margin-top:4px; border-bottom:none;\">\r\n    <thead>\r\n      <tr>\r\n        <th style=\"width:10%;\">QTY</th>\r\n        <th style=\"width:50%;\">DESCRIPTION</th>\r\n        <th style=\"width:20%;\">RATE</th>\r\n        <th style=\"width:10%;\">$</th>\r\n        <th style=\"width:10%;\">C</th>\r\n      </tr>\r\n    </thead>\r\n    <tbody>\r\n      {% for item in doc.items %}\r\n      <tr>\r\n        <td>{{ item.qty | int if item.qty == item.qty | int else item.qty }}</td>\r\n        <td class=\"desc-col\">{{ item.item_name or item.item_code }}</td>\r\n        <td class=\"amount-col\">{{ \"{:,.2f}\".format(item.rate) }}</td>\r\n        <td class=\"amount-col\">{{ \"{:,.0f}\".format(item.amount) }}</td>\r\n        <td class=\"amount-col\">{{ \"{:02.0f}\".format((item.amount % 1) * 100) }}</td>\r\n      </tr>\r\n      {% endfor %}\r\n    </tbody>\r\n  </table>\r\n\r\n  <!-- \u2550\u2550 SIGNATURES LEFT + TOTALS RIGHT \u2550\u2550 -->\r\n  <div style=\"display:flex; align-items:flex-start; margin-top:0; gap:0;\">\r\n\r\n    <!-- Signatures stacked vertically -->\r\n    <div style=\"flex:0 0 52%; padding-top:28px; padding-right:12px;\">\r\n      <div style=\"margin-bottom:8px;\">\r\n        <span class=\"sig-label\">PREPARED BY:</span>\r\n        <span style=\"display:inline-block; width:170px; border-bottom:1px dotted #555; vertical-align:bottom;\">&nbsp;</span>\r\n      </div>\r\n      <div style=\"margin-bottom:8px;\">\r\n        <span class=\"sig-label\">CHECKED BY:</span>\r\n        <span style=\"display:inline-block; width:177px; border-bottom:1px dotted #555; vertical-align:bottom;\">&nbsp;</span>\r\n      </div>\r\n      <div>\r\n        <span class=\"sig-label\">AUTHORISED BY:</span>\r\n        <span style=\"display:inline-block; width:163px; border-bottom:1px dotted #555; vertical-align:bottom;\">&nbsp;</span>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Totals -->\r\n    <div style=\"flex:0 0 48%; margin-top:1px;\">\r\n      <table class=\"totals-table\">\r\n        <tr>\r\n          <td class=\"lbl\">Sub Total &nbsp; $</td>\r\n          <td class=\"val\">{{ \"{:,.2f}\".format(doc.net_total) }}</td>\r\n        </tr>\r\n        <tr>\r\n          <td class=\"lbl\">VAT {{ doc.taxes[0].rate if doc.taxes else \"9\" }}% &nbsp; $</td>\r\n          <td class=\"val\">{{ \"{:,.2f}\".format(doc.total_taxes_and_charges) }}</td>\r\n        </tr>\r\n        <tr class=\"total-row\">\r\n          <td class=\"lbl\">TOTAL &nbsp; $</td>\r\n          <td class=\"val\">{{ \"{:,.2f}\".format(doc.grand_total) }}</td>\r\n        </tr>\r\n      </table>\r\n    </div>\r\n\r\n  </div>\r\n\r\n  <!-- \u2550\u2550 GOODS RECEIVED \u2550\u2550 -->\r\n  <div class=\"goods-received\">\r\n    GOODS RECEIVED IN GOOD ORDER &amp; CONDITION: _____________________________________________\r\n  </div>\r\n\r\n  <!-- \u2550\u2550 PAYMENT TERMS \u2550\u2550 -->\r\n  <div class=\"conditions-box\">\r\n    <strong>PAYMENT TERMS AND CONDITION:</strong> STRICTLY 30 DAYS FROM DATE OF INVOICE; CREDIT WILL BE PASSED FOR GOODS RETURNED WITHIN 14 DAYS OF PURCHASE APPROVED THEY ARE:\r\n    <ul>\r\n      <li>ACCOMPANIED BY ORIGINAL INVOICE FOR REFERENCE</li>\r\n      <li>HANDLING/SERVICE CHARGE OF 10% WILL BE DEDUCTIBLE FROM THE TOTAL AMOUNT</li>\r\n    </ul>\r\n    <div style=\"text-align:right; margin-top:2px; font-size:7pt;\">LPL/427/A/23</div>\r\n  </div>\r\n\r\n  <!-- \u2550\u2550 FOOTER \u2550\u2550 -->\r\n  <div class=\"pf-footer\">\r\n    <span>Carpenters Waters (Fiji) \u2013 Sales Invoice</span>\r\n    <span>Rev: {{ doc.amended_from and \"01\" or \"00\" }} &nbsp; {{ frappe.utils.formatdate(frappe.utils.nowdate(), \"ddMMMyyyy\") }}</span>\r\n    <span>Issue Date: {{ frappe.utils.now_datetime().strftime(\"%d/%m/%y\") }}</span>\r\n  </div>\r\n\r\n</div>",
